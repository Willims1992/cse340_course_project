<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

<p>Here are a few of our partner organizations:</p>

<% if (user && user.role_name === 'admin') { %>
    <p>
        <a href="/new-organization">Add New Organization</a>
    </p>
<% } %>

<% if (organizations && organizations.length > 0) { %>
    <ul>
        <% organizations.forEach(organization => { %>
            <li>
                <img
                    src="/images/<%= organization.logo_filename %>"
                    alt="<%= organization.name %> logo"
                    width="80"
                    height="100"
                >

                <h2>
                    <a href="/organization/<%= organization.organization_id %>">
                        <%= organization.name %>
                    </a>
                </h2>

                <p><%= organization.description %></p>

                <p>
                    <strong>Email:</strong>
                    <%= organization.contact_email %>
                </p>

                <% if (user && user.role_name === 'admin') { %>
                    <p>
                        <a href="/edit-organization/<%= organization.organization_id %>">
                            Edit Organization
                        </a>
                    </p>
                <% } %>
            </li>
        <% }) %>
    </ul>
<% } else { %>
    <p>No organizations are available.</p>
<% } %>


</main>

<%- include('partials/footer') %>
