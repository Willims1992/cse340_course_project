<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

```
<% if (user && user.role_name === 'admin') { %>
    <p>
        <a href="/new-project">Add a New Service Project</a>
    </p>
<% } %>

<% if (projects && projects.length > 0) { %>
    <ul>
        <% projects.forEach(project => { %>
            <li>
                <a href="/project/<%= project.project_id %>">
                    <%= project.title %>
                </a>

                (<a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>)

                <% if (user && user.role_name === 'admin') { %>
                    | <a href="/edit-project/<%= project.project_id %>">
                        Edit Project
                    </a>

                    | <a href="/project/<%= project.project_id %>/assign-categories">
                        Assign Categories
                    </a>
                <% } %>
            </li>
        <% }) %>
    </ul>
<% } else { %>
    <p>No service projects are available.</p>
<% } %>
```

</main>

<%- include('partials/footer') %>
